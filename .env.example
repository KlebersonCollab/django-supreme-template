# Django Settings
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Secret key for cryptographic signing
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# IMPORTANT: Change this in production!
DJANGO_SECRET_KEY=django-insecure-h$tolzfl80*2w(!b8na@@uz-5b&z_+z1ra2gj*m(v)3)e9ebji

# Debug mode (True/False)
# WARNING: Never set to True in production!
DJANGO_DEBUG=True

# Allowed hosts (comma-separated list)
# For production, add your domain: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# INTERNATIONALIZATION
# =============================================================================

# Language code (e.g., pt-br, en-us, es-es)
DJANGO_LANGUAGE_CODE=pt-br

# Time zone (e.g., America/Sao_Paulo, UTC, Europe/London)
DJANGO_TIME_ZONE=America/Sao_Paulo

# =============================================================================
# DATABASE (Optional - SQLite is used by default)
# =============================================================================

# Uncomment and configure if using PostgreSQL
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=5432

# Uncomment and configure if using MySQL
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=3306

# =============================================================================
# STATIC FILES (Optional)
# =============================================================================

# Static files URL (default: static/)
# STATIC_URL=static/

# Static files root directory (for collectstatic)
# STATIC_ROOT= BASE_DIR / "staticfiles"

# Media files root directory (for user uploads)
# MEDIA_ROOT= BASE_DIR / "media"
# MEDIA_URL=/media/

# =============================================================================
# EMAIL (Optional)
# =============================================================================

# Email backend (console for development, smtp for production)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Configuration (uncomment for production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-email@gmail.com

# =============================================================================
# CACHING (Optional)
# =============================================================================

# Redis cache (uncomment if using Redis)
# CACHE_URL=redis://localhost:6379/0

# =============================================================================
# CORS (Optional - if using Django CORS Headers)
# =============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# LOGGING (Optional)
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# =============================================================================
# JWT AUTHENTICATION (API)
# =============================================================================

# JWT Access token lifetime in minutes (default: 60)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# JWT Refresh token lifetime in days (default: 7)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Rotate refresh tokens (True/False, default: True)
JWT_ROTATE_REFRESH_TOKENS=True

# =============================================================================
# DJANGO-ALLAUTH (SSO)
# =============================================================================

# Site ID for django.contrib.sites (default: 1)
SITE_ID=1

# Email verification (none, optional, mandatory)
ACCOUNT_EMAIL_VERIFICATION=optional

# =============================================================================
# SOCIAL AUTHENTICATION PROVIDERS
# =============================================================================

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth2
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft OAuth2
MICROSOFT_TENANT=common
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# =============================================================================
# CLOUD STORAGE BACKENDS (Optional)
# =============================================================================
# Supports: AWS S3, Google Cloud Storage, Azure Blob Storage, DigitalOcean Spaces,
# Scaleway, MinIO, and other S3-compatible services
# Set STORAGE_BACKEND to: local, s3, gcs, or azure

# Storage backend (local, s3, gcs, azure)
# Default: local (uses local file system)
STORAGE_BACKEND=local

# =============================================================================
# AWS S3 / S3-COMPATIBLE STORAGE
# =============================================================================
# For AWS S3, DigitalOcean Spaces, Scaleway, MinIO, etc.

# AWS_STORAGE_BUCKET_NAME=my-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_REGION_NAME=us-east-1

# For S3-compatible services (DigitalOcean Spaces, Scaleway, MinIO)
# AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com

# Optional: Custom domain/CDN
# AWS_S3_CUSTOM_DOMAIN=cdn.example.com

# Optional: Location prefix in bucket
# AWS_S3_LOCATION=media

# Optional: Separate bucket for static files
# AWS_STATIC_BUCKET_NAME=my-static-bucket
# AWS_S3_STATIC_LOCATION=static

# Optional: ACL settings
# AWS_DEFAULT_ACL=public-read
# AWS_QUERYSTRING_AUTH=True
# AWS_QUERYSTRING_EXPIRE=3600

# =============================================================================
# GOOGLE CLOUD STORAGE
# =============================================================================

# GS_BUCKET_NAME=my-bucket-name
# GS_PROJECT_ID=my-project-id
# GS_CREDENTIALS=/path/to/credentials.json
# Or use GOOGLE_APPLICATION_CREDENTIALS environment variable

# Optional: Location prefix in bucket
# GS_LOCATION=media

# Optional: Separate bucket for static files
# GS_STATIC_BUCKET_NAME=my-static-bucket
# GS_STATIC_LOCATION=static

# Optional: ACL and expiration
# GS_DEFAULT_ACL=publicRead
# GS_QUERYSTRING_AUTH=True
# GS_EXPIRATION=86400

# =============================================================================
# AZURE BLOB STORAGE
# =============================================================================

# AZURE_ACCOUNT_NAME=myaccount
# AZURE_ACCOUNT_KEY=your-account-key
# AZURE_CONTAINER=my-container

# Or use connection string instead:
# AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# Optional: Location prefix in container
# AZURE_LOCATION=media

# Optional: Separate container for static files
# AZURE_STATIC_CONTAINER=static-container
# AZURE_STATIC_LOCATION=static

# Optional: Custom domain/CDN
# AZURE_CUSTOM_DOMAIN=cdn.example.com
# AZURE_URL_EXPIRATION_SECS=3600

# =============================================================================
# RATE LIMITING (Optional)
# =============================================================================
# Rate limits for API endpoints
# Format: "number/period" (e.g., "100/hour", "10/minute", "1000/day")

# Anonymous users rate limit
# RATE_LIMIT_ANON=100/hour

# Authenticated users rate limit
# RATE_LIMIT_USER=1000/hour

# Burst rate limit (for specific endpoints)
# RATE_LIMIT_BURST=10/minute

# =============================================================================
# DATABASE CONNECTION POOLING (Optional - PostgreSQL only)
# =============================================================================
# Enable connection pooling for PostgreSQL (useful for high concurrency)

# USE_DB_POOL=True
# DB_POOL_MAX_CONNS=20  # Maximum connections in pool
# DB_POOL_MIN_CONNS=5   # Minimum connections in pool

# =============================================================================
# SENTRY MONITORING (Optional)
# =============================================================================
# Error tracking and performance monitoring

# SENTRY_DSN=https://your-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production  # or development, staging
# SENTRY_RELEASE=my-app@1.0.0    # Application version
# SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of transactions (0.0 to 1.0)
# SENTRY_PROFILES_SAMPLE_RATE=0.1  # 10% of profiles
# SENTRY_SEND_DEFAULT_PII=False  # Send PII data (GDPR compliance)

# =============================================================================
# SECRETS MANAGEMENT (Optional)
# =============================================================================
# Support for multiple secret management providers:
# - AWS Secrets Manager
# - Google Cloud Secret Manager
# - Azure Key Vault
# - HashiCorp Vault
# - Environment Variables (default/fallback)

# Choose secret provider: aws, gcp, azure, vault, env (default)
# SECRETS_PROVIDER=env

# =============================================================================
# AWS SECRETS MANAGER
# =============================================================================
# SECRETS_PROVIDER=aws
# AWS_SECRETS_REGION=us-east-1  # or use AWS_REGION
# AWS_ACCESS_KEY_ID=your-access-key  # or use IAM role
# AWS_SECRET_ACCESS_KEY=your-secret-key  # or use IAM role

# =============================================================================
# GOOGLE CLOUD SECRET MANAGER
# =============================================================================
# SECRETS_PROVIDER=gcp
# GCP_PROJECT_ID=my-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# AZURE KEY VAULT
# =============================================================================
# SECRETS_PROVIDER=azure
# AZURE_KEY_VAULT_URL=https://my-vault.vault.azure.net/
# AZURE_CLIENT_ID=your-client-id  # or use Managed Identity
# AZURE_CLIENT_SECRET=your-client-secret  # or use Managed Identity
# AZURE_TENANT_ID=your-tenant-id  # or use Managed Identity

# =============================================================================
# HASHICORP VAULT
# =============================================================================
# SECRETS_PROVIDER=vault
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=your-vault-token
# VAULT_MOUNT_POINT=secret  # Default: secret
# VAULT_KV_VERSION=2  # 1 or 2 (default: 2)
